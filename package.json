{
  "name": "zolana-custom-rings",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "zolana/sdk-libs/ts",
    "sdk-libs/ts"
  ],
  "scripts": {
    "build:ts": "npm run build --workspace @heliuslabs/zolana && npm run build --workspace @heliuslabs/zolana-custom-rings",
    "check:ts": "npm run build --workspace @heliuslabs/zolana && npm run check --workspace @heliuslabs/zolana-custom-rings",
    "docs:ts": "npm run build --workspace @heliuslabs/zolana && typedoc --options sdk-libs/ts/typedoc.json",
    "test:ts": "npm run test --workspace @heliuslabs/zolana-custom-rings",
    "test:ts:e2e": "npm run test:e2e --workspace @heliuslabs/zolana-custom-rings"
  },
  "devDependencies": {
    "@solana/kit": "^8.3.0",
    "semver": "^7.8.5",
    "typedoc": "^0.28.20"
  }
}
